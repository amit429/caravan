NEXT_PUBLIC_SUPABASE_URL='supabase project link'
NEXT_PUBLIC_SUPABASE_ANON_KEY='supabase public anon key'
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_GENERATIVE_AI_API_KEY='gemini key from https://aistudio.google.com/apikey'
TAVILY_API_KEY='optional — from https://app.tavily.com. Scout works without it, just with no live web research.'

# Production only — local dev talks to `npx inngest-cli@latest dev` instead, no keys needed.
# From your app at https://app.inngest.com. Without these, the Chaser cron silently never fires.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Google OAuth client ID/secret are NOT set here — they're configured directly in the
# Supabase dashboard (Authentication -> Sign In / Providers -> Google), never in this app.
# See README.md "Getting started" for the full walkthrough.
